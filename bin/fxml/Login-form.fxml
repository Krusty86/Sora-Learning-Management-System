<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<HBox prefHeight="570.0" prefWidth="1121.0" styleClass="main-container" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginFormController">
    <children>
        <VBox alignment="CENTER" prefWidth="600.0" styleClass="left-section" HBox.hgrow="ALWAYS">
            <children>
                <StackPane VBox.vgrow="ALWAYS">
                    <children>
                        <Circle radius="150.0" styleClass="blur-circle-top" StackPane.alignment="TOP_RIGHT" />
                        <Circle radius="200.0" styleClass="blur-circle-bottom" StackPane.alignment="BOTTOM_LEFT" />
                        
                        <VBox maxWidth="450.0" spacing="40.0" styleClass="content-wrapper">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <StackPane prefHeight="50.0" prefWidth="50.0" styleClass="icon-container-primary">
                                            <Region prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: white; -fx-shape: 'M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18L12 21L19 17.18V13.18L12 17L5 13.18Z';" />
                                        </StackPane>
                                        <Label styleClass="brand-title" text="Sora" />
                                    </children>
                                </HBox>
      
                                <VBox spacing="15.0">
                                    <children>
                                        <Text lineSpacing="5.0" styleClass="hero-text" text="The future of learning, simplified." wrappingWidth="400.0" />
                                    </children>
                                </VBox>
                            </children>
                     <StackPane.margin>
                        <Insets top="50.0" />
                     </StackPane.margin>
                        </VBox>
                    </children>
                </StackPane>
                
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="footer-note">
                    <padding>
                        <Insets bottom="40.0" left="40.0" />
                    </padding>
                    <children>
                        <Region prefHeight="14.0" prefWidth="14.0" style="-fx-background-color: #3b82f6; -fx-shape: 'M12 3l1.912 5.813L21 9l-4.544 3.3L18 21l-6-3.862L6 21l1.544-8.7L3 9l7.088-.187L12 3z';" />
                        <Label text="Empowering the next generation" />
                    </children>
                </HBox>
            </children>
        </VBox>
  
        <VBox alignment="CENTER" prefWidth="600.0" styleClass="right-section" HBox.hgrow="ALWAYS">
            <children>
                <VBox maxWidth="350.0" spacing="30.0">
                    <children>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h2" text="Login" />
                                <Label styleClass="text-muted" text="Enter your credentials to access Sora" />
                            </children>
                        </VBox>
      
                        <VBox spacing="20.0" styleClass="login-form">
                            <children>
                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="input-label" text="Username" />
                                        <StackPane alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="usernameField" promptText="Enter your username" styleClass="login-input" />
                                                <Region maxHeight="16.0" maxWidth="16.0" style="-fx-background-color: #64748b; -fx-shape: 'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z';">
                                                    <StackPane.margin>
                                                        <Insets left="12.0" />
                                                    </StackPane.margin>
                                                </Region>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
      
                                <VBox spacing="8.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="input-label" text="Password" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button styleClass="btn-link-small" text="Forgot password?" />
                                            </children>
                                        </HBox>
                                        <StackPane alignment="CENTER_LEFT">
                                            <children>
                                                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-input" />
                                                <TextField fx:id="textField" promptText="Enter Password" visible="false" styleClass="login-input"/>
                                                <Region maxHeight="16.0" maxWidth="16.0" style="-fx-background-color: #64748b; -fx-shape: 'M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zM7 11V7a5 5 0 0 1 10 0v4';">
                                                    <StackPane.margin>
                                                        <Insets left="12.0" />
                                                    </StackPane.margin>
                                                </Region>
                                                <Button fx:id="showPasswordBtn" onAction="#handleShowPassword" styleClass="btn-icon-inside" StackPane.alignment="CENTER_RIGHT">
                                                    <graphic>
                                                        <Region prefHeight="18.0" prefWidth="18.0" style="-fx-background-color: #64748b; -fx-shape: 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zm11 5a5 5 0 1 0 0-10 5 5 0 0 0 0 10z';" />
                                                    </graphic>
                                                    <StackPane.margin>
                                                        <Insets right="5.0" />
                                                    </StackPane.margin>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
      
                                <Button fx:id="btn_signIn" maxWidth="1.7976931348623157E308" onAction="#handleSignIn" prefHeight="45.0" styleClass="btn-primary" text="Sign In" />
                            </children>
                        </VBox>
      
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label styleClass="text-muted" text="Don't have an account?" />
                                <Button styleClass="btn-link" text="Contact Admin" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                
                <Label styleClass="copyright-text" text="© 2024 Sora Education Group. All rights reserved.">
                    <VBox.margin>
                        <Insets top="100.0" />
                    </VBox.margin>
                </Label>
            </children>
        </VBox>
    </children>
   <stylesheets>
      <URL value="@style.css" />
      <URL value="@../application/login-form.css" />
   </stylesheets>
</HBox>
