<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      
      <HBox spacing="20.0">
         <children>
            <VBox prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 20;" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-background-color: #EFF6FF; -fx-padding: 8; -fx-background-radius: 8;" text="📝" textFill="#2563EB" />
                        <VBox>
                           <children>
                              <Label text="Total Assignments" textFill="#64748B">
                                 <font><Font name="System Medium" size="13.0" /></font>
                              </Label>
                              <Label text="156" textFill="#0F172A">
                                 <font><Font name="System Bold" size="22.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 20;" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-background-color: #FFFBEB; -fx-padding: 8; -fx-background-radius: 8;" text="⏳" textFill="#D97706" />
                        <VBox>
                           <children>
                              <Label text="Pending Review" textFill="#64748B">
                                 <font><Font name="System Medium" size="13.0" /></font>
                              </Label>
                              <Label text="24" textFill="#0F172A">
                                 <font><Font name="System Bold" size="22.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox prefHeight="100.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 20;" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-background-color: #F0FDF4; -fx-padding: 8; -fx-background-radius: 8;" text="✅" textFill="#16A34A" />
                        <VBox>
                           <children>
                              <Label text="Avg. Completion" textFill="#64748B">
                                 <font><Font name="System Medium" size="13.0" /></font>
                              </Label>
                              <Label text="88%" textFill="#0F172A">
                                 <font><Font name="System Bold" size="22.0" /></font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <TextField fx:id="assignmentSearchField" prefHeight="38.0" prefWidth="300.0" promptText="Search assignments..." style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;" />
            <Button mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 8 15;" text="Filter" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

      <TableView fx:id="assignmentTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTitle" prefWidth="300.0" text="Assignment Title" />
          <TableColumn fx:id="colCourse" prefWidth="200.0" text="Course" />
          <TableColumn fx:id="colDueDate" prefWidth="150.0" text="Due Date" />
          <TableColumn fx:id="colSubmissions" prefWidth="120.0" text="Submissions" />
          <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
          <TableColumn fx:id="colActions" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Actions" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
   </children>
</VBox>